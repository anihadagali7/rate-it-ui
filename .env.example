# Copy to .env and fill in. Only VITE_* variables reach the browser, and they are
# baked in at build time. Never put secrets here. See README.md for details.

# API base URL, no trailing slash. Local rate-it-service (dev database):
VITE_BASE_URL=http://localhost:8080

# Social sign-in (optional; each is only needed for that provider's sign-in)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_FACEBOOK_APP_ID=your-facebook-app-id
VITE_APPLE_CLIENT_ID=your-apple-services-id
VITE_APPLE_REDIRECT_URI=https://your-app-origin
